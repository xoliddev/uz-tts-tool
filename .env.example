# Copy to .env (or .env.txt) and fill in ONE of the two options.
# Real environment variables take priority over this file.

# --- Option A: Vertex AI with your gcloud login (default backend, no API key) ---
# Requires the gcloud CLI and `gcloud auth login`. Billed to this Cloud project.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional: which gcloud account to take the token from (if you have several)
GOOGLE_CLOUD_ACCOUNT=

# --- Option B: API key(s) ---
# Used with `--backend aistudio` (Gemini API key from AI Studio), or with the
# default vertex backend when GOOGLE_CLOUD_PROJECT is empty.
# Several keys, comma separated: when one hits its daily quota the next is used.
GOOGLE_TTS_API_KEY=
GEMINI_API_KEYS=
